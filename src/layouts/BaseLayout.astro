---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

interface Props {
	title: string;
	description?: string;
	lang?: string;
	headerVariant?: 'home' | 'minimal';
	backHref?: string;
	backLabel?: string;
}

const {
	title,
	description = site.description,
	lang = 'en',
	headerVariant = 'minimal',
	backHref,
	backLabel,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
const resolvedBackHref = backHref ?? `${base}`;
---

<!doctype html>
<html lang={lang} data-theme="belabs-brand">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="min-h-screen">
		<SiteHeader variant={headerVariant} backHref={resolvedBackHref} backLabel={backLabel} />
		<main>
			<slot />
		</main>
		<SiteFooter />

		<script>
			import { initReveal } from '../scripts/reveal';
			import { initScrollSpy } from '../scripts/scroll-spy';
			import { initScrollHeader } from '../scripts/scroll-header';

			initReveal();
			initScrollSpy();
			initScrollHeader();
			document.addEventListener('astro:page-load', () => {
				initReveal();
				initScrollSpy();
				initScrollHeader();
			});
		</script>
	</body>
</html>
