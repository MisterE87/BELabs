---
import { site } from '../lib/site';
---

<section id="contact" class="section-dark scroll-mt-20">
	<div class="page-shell py-20 text-center">
		<div class="reveal mx-auto max-w-2xl">
			<p class="eyebrow-on-dark">Contact</p>
			<h2 class="mt-4 text-3xl font-bold md:text-4xl">Say hello</h2>
			<p class="mt-4 text-lg text-white/80">
				Questions about a project, privacy policy, or something you spotted? Send a note — replies happen in spare time.
			</p>
			<a href={`mailto:${site.contactEmail}`} class="btn-brand mt-8">
				Email Erwin
			</a>
		</div>
	</div>
</section>
