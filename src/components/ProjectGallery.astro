---
import type { CollectionEntry } from 'astro:content';
import { projectGalleryUrl } from '../lib/projectAssets';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const slug = project.id;
const gallery = project.data.gallery ?? [];
---

{
	gallery.length > 0 && (
		<>
			<section class="border-b border-line bg-surface">
				<div class="page-shell py-16">
					<div class="project-gallery reveal">
						{gallery.map((item) => {
							const imageFiles = item.files ?? (item.file ? [item.file] : []);
							const orientationClass =
								item.orientation === 'portrait'
									? 'project-gallery-item--portrait'
									: 'project-gallery-item--landscape';
							const caption = item.caption ?? item.title ?? item.alt;

							return (
								<article class:list={['project-gallery-item', orientationClass]}>
									<div class="project-gallery-copy">
										{item.title && <h2 class="project-gallery-title">{item.title}</h2>}
										{item.caption && <p class="project-gallery-caption">{item.caption}</p>}
									</div>

									<div
										class:list={[
											'project-gallery-media',
											imageFiles.length > 1 && 'project-gallery-media--multi',
										]}
									>
										{imageFiles.map((filename, index) => {
											const src = projectGalleryUrl(slug, filename, base);
											const alt = imageFiles.length === 1 ? item.alt : `${item.alt} (${index + 1})`;

											return (
												<button
													type="button"
													class="project-gallery-trigger"
													data-lightbox-src={src}
													data-lightbox-alt={alt}
													data-lightbox-caption={caption}
													aria-label={`Enlarge: ${alt}`}
												>
													<img src={src} alt={alt} class="project-gallery-image" loading="lazy" />
													<span class="project-gallery-zoom-hint" aria-hidden="true">Click to enlarge</span>
												</button>
											);
										})}
									</div>
								</article>
							);
						})}
					</div>
				</div>
			</section>

			<dialog id="gallery-lightbox" class="gallery-lightbox" aria-label="Enlarged screenshot">
				<div class="gallery-lightbox-panel">
					<button type="button" class="gallery-lightbox-close" data-lightbox-close aria-label="Close">
						×
					</button>
					<img class="gallery-lightbox-image" alt="" />
					<p class="gallery-lightbox-caption"></p>
				</div>
			</dialog>

			<script>
				import { initGalleryLightbox } from '../scripts/gallery-lightbox';

				initGalleryLightbox();
				document.addEventListener('astro:page-load', initGalleryLightbox);
			</script>
		</>
	)
}
