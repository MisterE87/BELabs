---
import { site } from '../lib/site';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="footer-dark">
	<div class="mx-auto max-w-7xl px-6 py-14 lg:px-8">
		<div class="grid gap-10 md:grid-cols-3">
			<div>
				<p class="font-display text-lg font-extrabold text-white">{site.name}</p>
				<p class="mt-3 text-sm text-white/60">
					Build · Explore · Create
				</p>
			</div>

			<div>
				<p class="text-sm font-semibold uppercase tracking-wide text-white/50">Explore</p>
				<ul class="mt-4 space-y-2 text-sm">
					<li><a href={`${base}#about`} class="hover:text-white">About</a></li>
					<li><a href={`${base}#projects`} class="hover:text-white">Projects</a></li>
					<li><a href={`${base}#contact`} class="hover:text-white">Contact</a></li>
				</ul>
			</div>

			<div>
				<p class="text-sm font-semibold uppercase tracking-wide text-white/50">Legal & contact</p>
				<ul class="mt-4 space-y-2 text-sm">
					<li>
						<a href={`${base}privacy/farm-academy/`} class="hover:text-white">Farm Academy privacy (NL)</a>
					</li>
					<li>
						<a href={`mailto:${site.contactEmail}`} class="hover:text-white">{site.contactEmail}</a>
					</li>
				</ul>
			</div>
		</div>

		<p class="mt-12 border-t border-white/10 pt-8 text-sm text-white/50">
			&copy; {year} Erwin
		</p>
	</div>
</footer>
