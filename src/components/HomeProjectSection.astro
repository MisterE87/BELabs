---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
	eyebrow: string;
	title: string;
	projects: CollectionEntry<'projects'>[];
	linkHref: string;
	linkLabel: string;
	bandClass?: string;
}

const { eyebrow, title, projects, linkHref, linkLabel, bandClass = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class:list={['border-t border-line', bandClass]}>
	<div class="mx-auto max-w-6xl px-6 py-20">
		<div class="reveal mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="eyebrow">{eyebrow}</p>
				<h2 class="mt-3 text-4xl">{title}</h2>
			</div>
			<a href={`${base}${linkHref.replace(/^\//, '')}`} class="text-sm font-semibold uppercase tracking-wide text-accent-dark hover:text-accent">
				{linkLabel}
			</a>
		</div>

		<div class="grid gap-8 md:grid-cols-2">
			{projects.map((project) => (
				<div class="reveal">
					<ProjectCard project={project} />
				</div>
			))}
		</div>
	</div>
</section>
