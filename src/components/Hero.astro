---
interface Props {
	eyebrow?: string;
	title: string;
	description: string;
	primaryHref?: string;
	primaryLabel?: string;
	secondaryHref?: string;
	secondaryLabel?: string;
}

const {
	eyebrow = 'Hobby projects · side experiments',
	title,
	description,
	primaryHref = '/projects/',
	primaryLabel = 'Browse projects',
	secondaryHref = '/about/',
	secondaryLabel = 'About B&E Labs',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="page-header-bg relative overflow-hidden">
	<div class="relative mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-[1.2fr_0.8fr] md:py-28">
		<div class="reveal space-y-6">
			<p class="eyebrow">{eyebrow}</p>
			<h1 class="max-w-3xl text-5xl leading-tight md:text-6xl">{title}</h1>
			<p class="max-w-2xl text-xl text-muted">{description}</p>
			<div class="flex flex-wrap gap-4 pt-2">
				<a href={`${base}${primaryHref.replace(/^\//, '')}`} class="btn-primary">
					{primaryLabel}
				</a>
				<a href={`${base}${secondaryHref.replace(/^\//, '')}`} class="btn-secondary">
					{secondaryLabel}
				</a>
			</div>
		</div>

		<div class="reveal card-muted">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Why B&E?</p>
			<ul class="mt-6 space-y-4 text-muted">
				<li class="flex gap-3">
					<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent"></span>
					<span><strong class="text-ink">B</strong>enjamin — my son, who might join the experiments one day</span>
				</li>
				<li class="flex gap-3">
					<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-amber"></span>
					<span><strong class="text-ink">E</strong>rwin — product owner by day, curious builder in spare time</span>
				</li>
				<li class="flex gap-3">
					<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent"></span>
					<span>Small apps and sites for fun — not a startup pitch deck</span>
				</li>
			</ul>
		</div>
	</div>
</section>
