---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import ProjectMedia from './ProjectMedia.astro';
import { site } from '../lib/site';

interface Props {
	description: string;
	featuredProjects: CollectionEntry<'projects'>[];
}

const { description, featuredProjects } = Astro.props;
const base = import.meta.env.BASE_URL;
const brandIconSrc = `${base}images/BELabsIcon.png`;
---

<section id="top" class="hero-dark scroll-mt-20">
	<div class="page-shell flex min-h-[80vh] flex-col justify-center py-16 lg:py-24">
		<div class="reveal grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
			<div class="space-y-8">
				<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
					<img
						src={brandIconSrc}
						alt=""
						width="112"
						height="112"
						class="brand-icon-glow h-24 w-24 shrink-0 rounded-2xl object-cover md:h-28 md:w-28 md:rounded-3xl"
					/>
					<div>
						<p class="eyebrow-on-dark">{site.tagline}</p>
						<p class="mt-1 text-xs font-semibold uppercase tracking-[0.2em] text-white/60">
							Build · Explore · Create
						</p>
					</div>
				</div>
				<h1 class="text-4xl leading-[1.08] md:text-5xl lg:text-6xl">
					Small experiments from the van Wingerden kitchen table.
				</h1>
				<p class="max-w-xl text-lg text-white/80 md:text-xl">{description}</p>
				<div class="flex flex-wrap gap-4">
					<a href="#projects" class="btn-brand">Explore the lab</a>
					<a href="#about" class="btn-hero-secondary">About B&E Labs</a>
				</div>
			</div>

			<div class="reveal hero-bento">
				<p class="eyebrow-on-dark mb-3 px-1">Featured from the lab</p>
				<div class="grid grid-cols-2 gap-2">
					{
						featuredProjects.map((project) => (
							<a href={`${base}projects/${project.id}/`} class="hero-bento-tile group">
								<ProjectMedia project={project} variant="hero-tile" />
								<div class="hero-bento-overlay">
									<span class="font-semibold text-white">{project.data.title}</span>
									<StatusBadge status={project.data.status} tone="on-dark" />
								</div>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
