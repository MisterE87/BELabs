---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import ProjectShowcasePage from '../../components/ProjectShowcasePage.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
	const projects = await getCollection('projects');

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
const hasBody = (project.body ?? '').trim().length > 0;
---

<BaseLayout
	title={`${project.data.title} | ${site.name}`}
	description={project.data.hook}
	backHref={`${base}#projects`}
	backLabel="← All projects"
>
	{
		project.data.showcase ? (
			<ProjectShowcasePage project={project} hasBody={hasBody}>
				<Content />
			</ProjectShowcasePage>
		) : (
			<article>
				<section class="hero-dark border-b border-white/10">
					<div class="page-shell py-16">
						<div class="reveal grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
							<div class="space-y-6">
								<StatusBadge status={project.data.status} />
								<h1 class="text-4xl text-white md:text-5xl">{project.data.title}</h1>
								<p class="text-xl text-white/80">{project.data.hook}</p>
								<div class="flex flex-wrap gap-4">
									{
										project.data.projectUrl && (
											<a
												href={project.data.projectUrl}
												class="btn-hero-primary"
												target="_blank"
												rel="noopener noreferrer"
											>
												Visit project
											</a>
										)
									}
									{
										project.data.privacyUrl && (
											<a href={`${base}${project.data.privacyUrl.replace(/^\//, '')}`} class="btn-hero-secondary">
												Privacy policy
											</a>
										)
									}
								</div>
							</div>

							<div class="reveal">
								<ProjectMedia project={project} variant="detail" />
							</div>
						</div>
					</div>
				</section>

				<section class="page-shell">
					<div class="reveal prose-editorial max-w-3xl">
						<Content />
					</div>
				</section>
			</article>

			<ImageLightbox />
		)
	}
</BaseLayout>
