# Optional credentials for authenticated screenshot capture (never commit .env)
# Format: username:password — slug uses underscores instead of hyphens
CAPTURE_AUTH_board_stats=your-user:your-password

# Optional overrides when production pages need login (e.g. capture local dashboard)
# CAPTURE_URL_board_stats=http://127.0.0.1:3000/dashboard.php
# CAPTURE_LOGIN_URL_board_stats=http://127.0.0.1:3000/index.php
